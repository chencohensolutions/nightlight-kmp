<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark from the first frame so launching at night never flashes white. -->
    <style name="Theme.NightLight" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF1A0A00</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
